pragma ComponentBehavior: Bound

import Quickshell

// Update this list with:
// curl https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/glyphnames.json | jq -r '
// to_entries[] |
// select(.key != "METADATA") |
// "\"" + .key + "\": 0x" + (.value.code | ascii_upcase) + ","
// ' | wl-copy

Singleton {
    id: nerdfont

    function find(...icons): int {
        const badParts = ["com", "org", "kde", "gnome"];
        for (const icon of icons) {
            if (badParts.includes(icon)) {
                continue;
            }

            const split = icon.split(/[\s\-\.]+/);
            if (split.length > 1) {
                const code = find(...split);
                if (code !== 0) {
                    return code;
                }
            }

            const code = findCode(icon);
            if (code !== 0) {
                return code;
            }
        }
        return 0;
    }

    function findCode(icon: string): int {
        const name = icon.toLowerCase();
        if (names[name]) {
            return names[name];
        }
        if (extra[name]) {
            return extra[name];
        }
        for (const prefix of prefixes) {
            const prefixedName = `${prefix}-${name}`;
            if (names[prefixedName]) {
                return names[prefixedName];
            }
        }
        for (const r of fallback) {
            if (name.match(r.regex)) {
                return r.value;
            }
        }
        return 0;
    }

    readonly property var fallback: [
        {
            regex: /gtk-(demo|settings)/,
            value: names["linux-gtk"]
        },
        {
            regex: /neovim/,
            value: names["cod-settings"]
        },
        {
            regex: /kde-?connect/,
            value: names["linux-kde"]
        },
        {
            regex: /settings|nwg-look/,
            value: names["cod-settings"]
        },
        {
            regex: /blueman/,
            value: names["bluejooth"]
        },
        {
            regex: /nixos/,
            value: names["linux-nixos"]
        },
        {
            regex: /network/,
            value: names["md-network"]
        },
        {
            regex: /kitty/,
            value: names["cod-terminal"]
        },
        {
            regex: /obs/,
            value: names["md-record-circle"]
        },
        {
            regex: /btop/,
            value: names["md-dashboard"]
        },
        {
            regex: /steam_icon_.+/,
            value: names["fa-steam"]
        },
    ]

